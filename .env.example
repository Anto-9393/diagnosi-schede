# Copia questo file in .env e inserisci la chiave. Il .env non si condivide e non va su GitHub.

# Quale LLM usare: openai (chiave del corso, gpt-4o-mini come nelle lezioni) oppure anthropic (Claude)
PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Facoltativo: modelli diversi dai default
# openai:    MODEL_DEV=gpt-4o-mini        MODEL_DEMO=gpt-4o
# anthropic: MODEL_DEV=claude-haiku-5-5   MODEL_DEMO=claude-sonnet-5-5
