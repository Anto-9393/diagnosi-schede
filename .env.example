# Copia questo file in .env e inserisci la chiave. Il .env non si condivide e non va su GitHub.

# Quale LLM usare: openai (chiave del corso, gpt-4o-mini come nelle lezioni) oppure anthropic (Claude)
PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Facoltativo: modelli diversi dai default
# openai:    MODEL_DEV=gpt-4o-mini        MODEL_DEMO=gpt-4o
# anthropic: MODEL_DEV=claude-haiku-5-5   MODEL_DEMO=claude-sonnet-5-5

# Facoltativi: stima dei costi per Grafana (listino OpenAI in dollari per 1M token, e cambio euro per 1 dollaro)
# PREZZO_INPUT_USD_1M=0.15
# PREZZO_CACHE_USD_1M=0.075
# PREZZO_OUTPUT_USD_1M=0.60
# CAMBIO_USD_EUR=0.86

# Facoltativi: immagini dei dispositivi da Wikimedia (token personale OAuth 2.0, vedi scripts/scarica_immagini.py)
# WIKIMEDIA_TOKEN=
# WIKIMEDIA_CONTATTO=
